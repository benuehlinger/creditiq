# secrets — the FRED key never lands on disk
.env
.env.*
*.key
# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# node
node_modules/
dist/
# generated panels are large; parquet is regenerated with `make data`
# EVERYTHING under data/synthetic is generated by `make data` (or the in-app
# button) and rebuilds deterministically on any machine. Committing any of it
# shipped one machine's artifacts to every other and dirtied the tree on
# every rebuild (float formatting differs across numpy versions), which
# blocked every `git pull`. A clone is a clean app: code plus the committed
# FRED cache and scenario files, nothing user- or machine-generated.
data/synthetic/
docs/GENERATIVE_TRUTH.md
# saved models are the USER'S work product on THEIR machine, not source
versions/
.DS_Store
data/cache/
# superseded saved versions, archived out of the app
versions/archive-*/
